APP_ENV=development
APP_NAME=rag-production
LOG_LEVEL=INFO
LOG_FORMAT=json
USE_FAKE_PROVIDERS=true

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_FALLBACK_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

PINECONE_API_KEY=
PINECONE_INDEX=rag-hybrid
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

REDIS_URL=redis://localhost:6379/0
CACHE_FAIL_OPEN=true
CACHE_TTL_SECONDS=600
SEMANTIC_CACHE_ENABLED=false
SEMANTIC_CACHE_THRESHOLD=0.92

JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
DEMO_USERS=analyst:analystpass:tenant-a:analyst,admin:adminpass:tenant-a:admin,other:otherpass:tenant-b:analyst

VECTOR_TOP_K=20
BM25_TOP_K=20
RERANK_TOP_K=12
RRF_K=60
MAX_CONTEXT_TOKENS=3500
MAX_CHUNKS_PER_SOURCE=3

CHUNK_SIZE=512
CHUNK_OVERLAP=64

MAX_RETRIES=3
RETRY_BASE_SECONDS=0.4
RETRY_MAX_SECONDS=8.0

LLM_TIMEOUT_SECONDS=30
EMBEDDING_TIMEOUT_SECONDS=15
PINECONE_TIMEOUT_SECONDS=8
RERANKER_TIMEOUT_SECONDS=12
REDIS_TIMEOUT_SECONDS=2

MAX_QUERY_LENGTH=2000
MAX_DOCUMENT_SIZE=200000

MAX_LLM_CONCURRENCY=8
MAX_EMBEDDING_CONCURRENCY=8
MAX_RERANK_CONCURRENCY=4

RATE_LIMIT_PER_USER_PER_MINUTE=60
RATE_LIMIT_PER_TENANT_PER_MINUTE=300

CORS_ALLOWED_ORIGINS=http://localhost:3000

PROMPT_VERSION=v2
INDEX_VERSION=v1
EMBEDDING_MODEL_VERSION=v1

OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=rag-backend

SSE_HEARTBEAT_SECONDS=15
SSE_QUEUE_MAX_SIZE=500

CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RESET_SECONDS=30

REWRITE_ENABLED=true
